<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store. Package/build-msix.ps1 fills in {VERSION}.
  Identity, Publisher and PublisherDisplayName come from Partner Center (Product identity) and must match exactly.
  The Store signs the package, so it's uploaded unsigned.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="PatrickHopman.BPGPUpdater"
    Publisher="CN=B7FBC900-829F-4221-9B58-0222876AC75C"
    Version="{VERSION}"
    ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>BPGP Updater</DisplayName>
    <PublisherDisplayName>Patrick Hopman</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="BPGPUpdater" Executable="BPGPUpdater.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="BPGP Updater"
        Description="Installs and updates the BPGP World of Warcraft addon and shows the raid schedule."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- A normal desktop app: it writes BPGP into the World of Warcraft AddOns folder -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

<!--
    BPGP Updater look, taken from the addon's design (docs/design/bp-epgp-redesign.dc.html, Modules/UI):
    dark frames with bronze borders, gold Marcellus titles, red Blizzard-style buttons, tabs along the bottom.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colours -->
    <Color x:Key="FrameColor">#1A1714</Color>
    <Color x:Key="InsetColor">#100F0D</Color>
    <Color x:Key="BronzeColor">#6B5A3A</Color>
    <Color x:Key="BronzeDarkColor">#3A332C</Color>
    <Color x:Key="GoldColor">#FFD100</Color>
    <Color x:Key="PaleGoldColor">#E6CC80</Color>
    <Color x:Key="TextColor">#EFE6D6</Color>
    <Color x:Key="MutedColor">#9D9D9D</Color>
    <Color x:Key="GoodColor">#1EFF00</Color>
    <Color x:Key="BadColor">#FF4040</Color>

    <SolidColorBrush x:Key="FrameBrush" Color="{StaticResource FrameColor}" />
    <SolidColorBrush x:Key="InsetBrush" Color="{StaticResource InsetColor}" />
    <SolidColorBrush x:Key="BronzeBrush" Color="{StaticResource BronzeColor}" />
    <SolidColorBrush x:Key="BronzeDarkBrush" Color="{StaticResource BronzeDarkColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="PaleGoldBrush" Color="{StaticResource PaleGoldColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />

    <LinearGradientBrush x:Key="RedButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B8160D" Offset="0" />
        <GradientStop Color="#7A0F08" Offset="0.55" />
        <GradientStop Color="#4E0904" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RedButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D8221A" Offset="0" />
        <GradientStop Color="#981409" Offset="0.55" />
        <GradientStop Color="#600B05" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DarkButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A332C" Offset="0" />
        <GradientStop Color="#191511" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DarkButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A4136" Offset="0" />
        <GradientStop Color="#231E18" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A241E" Offset="0" />
        <GradientStop Color="#15120F" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="TitleFont">pack://application:,,,/BPGPUpdater;component/Fonts/#Marcellus</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>

    <!-- Text -->
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Title}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource PaleGoldBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PaleGoldBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BigValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <!-- Inset well: a darker panel with a thin bronze edge -->
    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BronzeDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Buttons: red primary (UIPanelButtonTemplate), dark secondary -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource DarkButtonBrush}" />
        <Setter Property="Tag" Value="{StaticResource DarkButtonHoverBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outer" CornerRadius="3" BorderBrush="Black" BorderThickness="1" Background="{TemplateBinding Background}">
                        <Border x:Name="Inner" CornerRadius="2" BorderBrush="{StaticResource BronzeBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource PaleGoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Inner" Property="Margin" Value="0,1,0,-1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource PaleGoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outer" Property="Background" Value="#2A2622" />
                            <Setter TargetName="Inner" Property="BorderBrush" Value="#3A332C" />
                            <Setter Property="Foreground" Value="#6F6A62" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource RedButtonBrush}" />
        <Setter Property="Tag" Value="{StaticResource RedButtonHoverBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="22,8" />
        <Setter Property="MinWidth" Value="170" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

    <!-- Title bar buttons (minimize, close): small squares like the Blizzard close button -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource PaleGoldBrush}" />
        <Setter Property="Background" Value="{StaticResource DarkButtonBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" CornerRadius="3" BorderBrush="{StaticResource BronzeBrush}" BorderThickness="1" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PaleGoldBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource DarkButtonHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Background" Value="{StaticResource RedButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
    </Style>

    <!-- Read-only text box (folder path) -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BronzeDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="CaretBrush" Value="{StaticResource GoldBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BronzeBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Check box: gold tick in a bronze square, like the addon's settings -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="2" Background="{StaticResource InsetBrush}"
                                BorderBrush="{StaticResource BronzeBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M 3,9 L 7,13 L 15,4" Stroke="{StaticResource GoldBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PaleGoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hyperlinks in gold -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource PaleGoldBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dark scroll bar for the changelog -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="4" Background="{StaticResource BronzeBrush}" Margin="2,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabs along the bottom, like the addon's main window (PanelTabButtonTemplate) -->
    <Style TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Bottom" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0" ContentSource="SelectedContent" />
                        <TabPanel Grid.Row="1" IsItemsHost="True" Margin="14,-1,0,0" Panel.ZIndex="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Font and colour are set on the tab's own header only, so the tab's content keeps the body font -->
    <Style TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab" Margin="0,0,4,0" Padding="20,7,20,9" CornerRadius="0,0,5,5"
                            BorderBrush="{StaticResource BronzeBrush}" BorderThickness="1,0,1,1" Background="{StaticResource DarkButtonBrush}"
                            TextElement.FontFamily="{StaticResource TitleFont}" TextElement.FontSize="14"
                            TextElement.Foreground="{StaticResource PaleGoldBrush}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tab" Property="Background" Value="{StaticResource FrameBrush}" />
                            <Setter TargetName="Tab" Property="Padding" Value="20,9,20,10" />
                            <Setter TargetName="Tab" Property="TextElement.Foreground" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tab" Property="Background" Value="{StaticResource DarkButtonHoverBrush}" />
                            <Setter TargetName="Tab" Property="TextElement.Foreground" Value="{StaticResource GoldBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

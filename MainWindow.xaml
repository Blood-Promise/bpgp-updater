<Window x:Class="BPGPUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPGP Updater" Width="640" Height="540" MinWidth="540" MinHeight="470"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" FontFamily="{StaticResource BodyFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <!-- Own frame like the addon's PortraitFrameTemplate: no Windows title bar -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!--
        The window itself is transparent: the frame ends above the bottom row, and the tabs hang below
        the frame like in the addon's main window. The tab strip row is as high as TabStripHeight in Theme.xaml.
    -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource TabStripHeight}" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BronzeBrush}" BorderThickness="2" Background="{StaticResource FrameBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: portrait with the logo, title, minimize and close -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BronzeDarkBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                        <Ellipse Fill="Black" Stroke="{StaticResource PaleGoldBrush}" StrokeThickness="2" />
                        <Ellipse Margin="5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="pack://application:,,,/BPGPUpdater;component/Images/bpgp.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="BPGP Updater" Style="{StaticResource Title}" FontSize="20" />
                        <TextBlock x:Name="TitleVersion" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="10,0,0,3" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize to the tray">
                            <Path Data="M 0,0 L 10,0" Stroke="{StaticResource PaleGoldBrush}" StrokeThickness="2" Margin="0,8,0,0" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="6,0,0,0" ToolTip="Close">
                            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{StaticResource GoldBrush}" StrokeThickness="2" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
        </Border>

        <!-- Over the frame (below the title bar) and the tab strip row: content inside, tabs outside -->
        <TabControl x:Name="Tabs" Grid.Row="0" Grid.RowSpan="2" Margin="2,70,2,0">
                <!-- BPGP: installed and latest version, Install / Update, what's new -->
                <TabItem Header="BPGP">
                    <Grid Margin="14,0,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Inset}">
                                <StackPanel>
                                    <TextBlock Text="INSTALLED" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="InstalledValue" Style="{StaticResource BigValue}" Text="–" />
                                    <TextBlock x:Name="InstalledNote" Style="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Inset}">
                                <StackPanel>
                                    <TextBlock Text="LATEST" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="LatestValue" Style="{StaticResource BigValue}" Foreground="{StaticResource GoldBrush}" Text="–" />
                                    <TextBlock x:Name="LatestNote" Style="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="InstallButton" Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Install" IsDefault="True" />
                            <Button x:Name="CheckButton" Grid.Column="1" Content="Check again" Margin="10,0,0,0" />
                            <Button x:Name="UninstallButton" Grid.Column="2" Content="Uninstall" Margin="10,0,0,0" MinWidth="0"
                                    ToolTip="Remove BPGP from the AddOns folder, with or without its settings." />
                            <!-- Status line: what the updater is doing or found -->
                            <TextBlock x:Name="StatusText" Grid.Column="3" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12" />
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Inset}">
                            <DockPanel>
                                <TextBlock x:Name="ChangelogHeading" DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="What's new" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ChangelogText" Style="{StaticResource Body}" Margin="0,0,6,0" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Raids: the guild's raid schedule from Google Sheets -->
                <TabItem Header="Raids">
                    <Grid Margin="14,0,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="NextRaidPanel" Grid.Row="0" Style="{StaticResource Inset}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NEXT RAID" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="NextRaidValue" Style="{StaticResource BigValue}" Text="–" />
                                    <TextBlock x:Name="NextRaidNote" Style="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="COMING" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="NextRaidCount" Style="{StaticResource BigValue}" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Right" Text="–" />
                                    <TextBlock x:Name="NextRaidMe" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                                </StackPanel>
                                <TextBlock x:Name="NextRaidAbsent" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                            </Grid>
                        </Border>
                        <Border x:Name="RaidListPanel" Grid.Row="1" Style="{StaticResource Inset}" Margin="0,12,0,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Upcoming raids" Style="{StaticResource Heading}" />
                                    <Button x:Name="RefreshScheduleButton" Grid.Column="1" Content="Refresh" MinWidth="0" Padding="12,3" VerticalAlignment="Top" />
                                </Grid>
                                <!-- Status line: when the sheet was read, or what went wrong -->
                                <TextBlock x:Name="RaidsStatusText" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                    <StackPanel x:Name="RaidList" Margin="0,0,6,0" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <!-- Instead of the above when no link is set -->
                        <Border x:Name="NoSchedulePanel" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource Inset}" VerticalAlignment="Top" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Raid schedule" Style="{StaticResource Heading}" />
                                <TextBlock Style="{StaticResource Body}"
                                           Text="See the guild's raid nights and who's coming, and get a reminder two hours before a raid. Paste the link to the raid schedule sheet under Settings." />
                                <Button x:Name="ScheduleSettingsButton" Content="Open Settings" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Settings: WoW folder, raid schedule, Start with Windows, beta versions, backups -->
                <TabItem x:Name="SettingsTab" Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,0,4,12">
                    <StackPanel Margin="0,0,10,0">
                        <Border Style="{StaticResource Inset}">
                            <StackPanel>
                                <TextBlock Text="World of Warcraft" Style="{StaticResource Heading}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                           Text="The World of Warcraft folder, with _retail_ in it. BPGP goes into _retail_\Interface\AddOns." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FolderBox" Grid.Column="0" IsReadOnly="True" />
                                    <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Raid schedule" Style="{StaticResource Heading}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                           Text="The link to the guild's raid schedule in Google Sheets: copy it from the address bar. The sheet has to be shared as &quot;Anyone with the link can view&quot;." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ScheduleLinkBox" Grid.Column="0" />
                                    <Button x:Name="SaveLinkButton" Grid.Column="1" Content="Save" Margin="8,0,0,0" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="I am" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="CharacterBox" Grid.Column="1" MinWidth="180" Margin="10,0,0,0"
                                              ToolTip="Your name in the sheet: the Raids tab shows whether you're in, and there's no reminder when you're marked absent." />
                                </Grid>
                                <TextBlock x:Name="ScheduleStatusText" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="In the background" Style="{StaticResource Heading}" />
                                <CheckBox x:Name="AutostartBox" Content="Start with Windows" />
                                <TextBlock x:Name="AutostartNote" Style="{StaticResource Muted}" Margin="26,6,0,0"
                                           Text="BPGP Updater waits next to the clock, checks for a new BPGP every 6 hours and reminds you two hours before a raid. Minimizing always sends it there; double-click the icon to open it again." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="BPGP versions" Style="{StaticResource Heading}" />
                                <CheckBox x:Name="BetaBox" Content="Get beta versions of BPGP" />
                                <TextBlock x:Name="BetaNote" Style="{StaticResource Muted}" Margin="26,6,0,0"
                                           Text="For officers who test a new BPGP before the raiders get it. Turned off, a beta you have stays until the next normal release replaces it." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Backups of your BPGP settings" Style="{StaticResource Heading}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                           Text="Before every install, update, uninstall and restore, BPGP Updater copies your BPGP settings and data (BPGP.lua in the WTF folder). The last 5 copies are kept." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="BackupBox" Grid.Column="0" />
                                    <Button x:Name="RestoreButton" Grid.Column="1" Content="Restore…" Margin="8,0,0,0" MinWidth="0" />
                                    <Button x:Name="OpenBackupsButton" Grid.Column="2" Content="Open folder" Margin="8,0,0,0" MinWidth="0" />
                                </Grid>
                                <TextBlock x:Name="BackupStatusText" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- About -->
                <TabItem Header="About">
                    <Border Style="{StaticResource Inset}" Margin="14,0,14,12" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/BPGPUpdater;component/Images/bpgp.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="BPGP Updater" Style="{StaticResource Title}" FontSize="20" />
                                    <TextBlock x:Name="AboutVersion" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Body}" Margin="0,14,0,0"
                                       Text="Installs and updates the BPGP addon from GitHub, so you don't need an addon manager. Your BPGP settings and data (WTF folder) are never touched." />
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Margin="0,0,0,4"><Hyperlink x:Name="RepoLink">BPGP on GitHub</Hyperlink></TextBlock>
                                <TextBlock Margin="0,0,0,4"><Hyperlink x:Name="ReleasesLink">All BPGP releases</Hyperlink></TextBlock>
                                <TextBlock Margin="0,0,0,4"><Hyperlink x:Name="UpdaterLink">BPGP Updater on GitHub</Hyperlink></TextBlock>
                                <TextBlock><Hyperlink x:Name="IssuesLink">Report a problem with the updater</Hyperlink></TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" FontSize="12"
                                       Text="Apache License 2.0. BPGP is based on Core Loot Manager by Lantis and contributors. Title font: Marcellus (SIL Open Font License)." />
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
    </Grid>
</Window>
